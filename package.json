{
  "name": "@fiduswriter/document-template-editor",
  "version": "0.1.16",
  "description": "Fidus Writer document template editor",
  "keywords": [
    "fiduswriter",
    "document-template",
    "template-editor",
    "publishing"
  ],
  "homepage": "https://git.fiduswriter.org/fiduswriter/fiduswriter-document-template-editor-ts",
  "bugs": {
    "url": "https://git.fiduswriter.org/fiduswriter/fiduswriter-document-template-editor-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://git.fiduswriter.org/fiduswriter/fiduswriter-document-template-editor-ts.git"
  },
  "license": "AGPL-3.0",
  "author": "Johannes Wilm",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "css/",
    "dist/",
    "src/",
    "locale/*/messages.json",
    "LICENSE",
    "README.md",
    "logo.svg"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
    "install-hooks": "husky"
  },
  "dependencies": {
    "@fiduswriter/document": "^0.2.41",
    "downloadjs": "^1.4.7",
    "fast-deep-equal": "^3.1.3",
    "fwtoolkit": "^0.2.10",
    "jszip": "^3.10.1",
    "prosemirror-commands": "^1.7.0",
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.3.2",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-menu": "^1.2.4",
    "prosemirror-model": "^1.25.0",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.6.4",
    "prosemirror-view": "^1.38.1",
    "sortablejs": "^1.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.7.0",
    "gettext-parser": "^9.1.1",
    "globals": "^15.15.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.8",
    "prettier": "^3.5.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "fiduswriter": {
    "css": {
      "fwtoolkit": [
        "colors.css",
        "forms.css",
        "buttons.css",
        "dialog.css",
        "common.css"
      ],
      "own": {
        "additive": [],
        "component": [
          "document_template_designer.css"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{ts,js,mjs,css,md,json,html}": [
      "prettier --write"
    ],
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "sh -c 'npm run typecheck'"
    ]
  }
}
